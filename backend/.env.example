# --- SpecterGate panel ---
SPECTERGATE_SECRET_KEY=replace-with-openssl-rand-hex-32
SPECTERGATE_ADMIN_USERNAME=admin
SPECTERGATE_ADMIN_PASSWORD=change-this-password
SPECTERGATE_PUBLIC_HOST=panel.example.com
SPECTERGATE_SUBSCRIPTION_BASE_URL=https://panel.example.com
SPECTERGATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite (default) or PostgreSQL:
# SPECTERGATE_DATABASE_URL=postgresql+psycopg://spectergate:password@db:5432/spectergate
SPECTERGATE_DATABASE_URL=sqlite:///./data/spectergate.db

# Xray-core
SPECTERGATE_XRAY_ENABLED=true
SPECTERGATE_XRAY_BINARY=/usr/local/bin/xray
SPECTERGATE_XRAY_CONFIG_PATH=./data/xray/config.json
SPECTERGATE_XRAY_LOG_PATH=./data/xray/xray.log
SPECTERGATE_XRAY_API_ADDRESS=127.0.0.1:10085

# Set true only for a demo environment; creates sample users and inbounds.
SPECTERGATE_DEMO_DATA=false

# Use false ONLY for local development over HTTP. Production requires HTTPS.
SPECTERGATE_SESSION_COOKIE_SECURE=true
