[Unit]
Description=SpecterGate Node Agent (Xray)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binding privileged ports (443) requires root or CAP_NET_BIND_SERVICE.
User=root
Group=root
EnvironmentFile=/etc/spectergate/agent.env
ExecStart=/usr/bin/python3 /opt/spectergate-agent/spectergate_agent.py
Restart=always
RestartSec=10
TimeoutStopSec=25
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/etc/spectergate /var/lib/spectergate-agent /var/log

[Install]
WantedBy=multi-user.target
