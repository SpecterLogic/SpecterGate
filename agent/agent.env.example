SPECTERGATE_PANEL_URL=https://panel.example.com
SPECTERGATE_NODE_KEY=replace-with-the-node-api-key
SPECTERGATE_XRAY_BINARY=/usr/local/bin/xray
SPECTERGATE_AGENT_CONFIG=/etc/spectergate/xray.json
SPECTERGATE_AGENT_STATE=/var/lib/spectergate-agent/state.json
SPECTERGATE_AGENT_LOG=/var/log/spectergate-agent.log
SPECTERGATE_XRAY_API=127.0.0.1:10085
SPECTERGATE_XRAY_ASSET=/usr/local/share/xray
SPECTERGATE_AGENT_INTERVAL=60
