# Copy to .env before running docker compose.
# Generate a secret with: openssl rand -hex 32
SPECTERGATE_SECRET_KEY=replace-with-a-long-random-secret
SPECTERGATE_ADMIN_USERNAME=admin
SPECTERGATE_ADMIN_PASSWORD=replace-with-a-strong-password
SPECTERGATE_PUBLIC_HOST=panel.example.com
SPECTERGATE_SUBSCRIPTION_BASE_URL=https://panel.example.com

# Needed with PostgreSQL, MySQL, MariaDB or TimescaleDB overrides.
# Use URL-safe random values, e.g. openssl rand -hex 32.
SPECTERGATE_DB_PASSWORD=replace-with-a-strong-db-password
# Separate privileged password for MySQL/MariaDB/TimescaleDB:
SPECTERGATE_DB_ADMIN_PASSWORD=replace-with-a-different-strong-password

# Optional Xray-core release used by the backend image.
XRAY_VERSION=26.3.27

# Custom Xray versions require the matching archive SHA-256 for your architecture.
# XRAY_SHA256=
